# Optional: enables cross-device cloud sync of mission progress via Supabase.
# Without these, the app works fully offline using localStorage only.
#
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in the project's SQL editor
# 3. Project Settings > API Keys > "Publishable and secret API keys" tab
#    Copy the Project URL and the Publishable key (starts with sb_publishable_...)
#    Do NOT use the Secret key, or the legacy service_role key - those are
#    server-only and must never be set here (this var is bundled into the
#    client-side JS that ships to every visitor's browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
